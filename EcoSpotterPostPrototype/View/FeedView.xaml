<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EcoSpotterPostPrototype.Model"
             x:Class="EcoSpotterPostPrototype.FeedView"
             Title="EcoSpotter Feed"
             BackgroundColor="#F5F5F7">
    <!-- Wrap your main page inside a Grid to place the header cleanly at the top -->
    <Grid RowDefinitions="Auto, *">

        <!-- TOP APPLICATION HEADER BAR -->
        <Grid Grid.Row="0" 
          ColumnDefinitions="*, Auto" 
          Padding="20, 40, 20, 10" 
          BackgroundColor="#F5F5F7">

            <!-- App branding / page title -->
            <Label Grid.Column="0" 
               Text="EcoSpotter" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="#212121" 
               VerticalOptions="Center"/>

            <!-- Clickable Profile Picture Frame -->
            <Border Grid.Column="1" 
                StrokeShape="RoundRectangle 20" 
                HeightRequest="40" 
                WidthRequest="40" 
                StrokeThickness="0"
                VerticalOptions="Center">
                <ImageButton x:Name="ProfileHeaderButton"
                         Aspect="AspectFill" 
                         Clicked="OnProfileHeaderClicked"/>
            </Border>
        </Grid>

        <!-- YOUR FEED OR FORM CONTENT SITS HERE -->
        <Button 
            x:Name="RefreshButton"
            Text="Refresh"  
            Clicked="RefreshButton_Clicked"/>
        
        <ScrollView Grid.Row="1">
            <!-- Feed CollectionView or camera view elements go here -->

            <!-- Main container for the scrolling feed list -->
            <CollectionView x:Name="FeedCollectionView" Margin="0,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Post">

                        <!-- Individual Post Card -->
                        <Border StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0"
                        BackgroundColor="White" 
                        Margin="16,8"
                        Padding="16"
                        Shadow="{Shadow Brush=Black, Offset='0,2', Radius=8, Opacity=0.05}">

                            <VerticalStackLayout Spacing="12">

                                <!-- 1. HEADER row: Profile picture, Name, and Date -->
                                <Grid ColumnDefinitions="48, *, Auto" ColumnSpacing="12">
                                    <!-- Profile Picture Frame -->
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 24" HeightRequest="48" WidthRequest="48" StrokeThickness="0">
                                        <Image Source="{Binding AuthorProfile.ProfilePictureUrl}" Aspect="AspectFill" BackgroundColor="#E0E0E0"/>
                                    </Border>

                                    <!-- User Details -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding AuthorProfile.Name}" FontAttributes="Bold" FontSize="16" TextColor="#212121"/>
                                        <Label Text="{Binding FormattedDate}" FontSize="12" TextColor="#757575"/>
                                    </VerticalStackLayout>

                                    <!-- Location Tag -->
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Start" Margin="0,4,0,0">
                                        <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding Location}" FontSize="13" TextColor="#2D9CDB" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- 2. DESCRIPTION TEXT -->
                                <Label Text="{Binding Description}" FontSize="15" TextColor="#333333" LineBreakMode="WordWrap" Margin="0,4"/>

                                <!-- 3. IMAGES CAROUSELVIEW (Swipes between Before & After) -->
                                <!-- 3. IMAGES CAROUSELVIEW (Swipes between Before & After) -->
                                <Grid RowDefinitions="*, Auto">

                                    <!-- Carousel points to indicator below via x:Reference -->
                                    <CarouselView x:Name="PostImagesCarousel"
                  Grid.Row="0"
                  ItemsSource="{Binding Images}"
                  IndicatorView="{x:Reference postIndicator}"
                  HeightRequest="250"
                  HorizontalOptions="FillAndExpand">
                                        <CarouselView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" Margin="0,0,4,0">
                                                    <Image Source="{Binding .}" Aspect="AspectFill" BackgroundColor="#F0F0F0"/>
                                                </Border>
                                            </DataTemplate>
                                        </CarouselView.ItemTemplate>
                                    </CarouselView>

                                    <!-- Clean IndicatorView: NO ItemsSource attribute -->
                                    <IndicatorView x:Name="postIndicator"
                   Grid.Row="1" 
                   HorizontalOptions="Center" 
                   Margin="0,8,0,0"
                   IndicatorColor="#D3D3D3"
                   SelectedIndicatorColor="#2D9CDB"
                   IndicatorSize="6" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
        <Grid x:Name="LoadingOverlay"
      RowSpan="2"
      IsVisible="False"
      BackgroundColor="#80000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" WidthRequest="48" HeightRequest="48" Color="#2D9CDB"/>
                <Label Text="Loading..." TextColor="White" HorizontalTextAlignment="Center" FontSize="14"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>